# Ключ OpenAI-совместимого API. Пусто — сервис работает на запасных правилах без ИИ.
LLM_API_KEY=

# Адрес API: OpenAI, LiteLLM, OpenRouter или любой совместимый шлюз.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini

# Необязательно: minimal | low | medium | high — для reasoning-моделей, ускоряет ответ.
LLM_REASONING_EFFORT=

# Попадает в промпт: от чьего имени готовим ответы.
ORG_NAME=учебное заведение

# Порт веб-интерфейса на вашей машине.
PORT=8000
